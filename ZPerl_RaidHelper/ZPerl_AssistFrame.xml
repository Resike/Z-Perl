<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">

	<Script file="ZPerl_AssistFrame.lua"/>

	<Frame name="ZPerl_ListTemplate" inherits="ZPerl_BackdropTemplate" virtual="true">
		<Layers>
			<Layer level="ARTWORK">
				<FontString name="$parentText" inherits="GameFontNormalSmall" justifyH="LEFT" justifyV="TOP">
					<Anchors>
						<Anchor point="TOPLEFT"/>
						<Anchor point="BOTTOMRIGHT"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
	</Frame>

	<Frame name="ZPerl_Assists_FrameAnchor" movable="true" resizable="true" parent="UIParent" inherits="ZPerl_BackdropTemplate" clampedToScreen="true">
		<Size>
			<AbsDimension x="330" y="124"/>
		</Size>
	</Frame>

	<Frame name="ZPerl_Assists_Frame" frameStrata="LOW" resizable="true" parent="ZPerl_Assists_FrameAnchor" inherits="ZPerl_BackdropTemplate" hidden="true" enableMouse="true" clampedToScreen="true">
		<KeyValues>
			<KeyValue key="backdropInfo" value="ZPerl_Raid_Backdrop_32_16_3333" type="global"/>
		</KeyValues>
		<Size>
			<AbsDimension x="330" y="124"/>
		</Size>
		<Anchors>
			<Anchor point="TOPLEFT"/>
		</Anchors>
		<Frames>
			<Button name="ZPerl_AssistsCloseButton" inherits="UIPanelCloseButton">
				<Size>
					<AbsDimension x="20" y="20"/>
				</Size>
				<Anchors>
					<Anchor point="TOPRIGHT"/>
				</Anchors>
				<Scripts>
					<OnClick>
						ZPerl.RaidHelper.AssistsViewClose()
					</OnClick>
				</Scripts>
			</Button>

			<Button name="ZPerl_AssistPin" inherits="ZPerl_BasicButton">
				<Size>
					<AbsDimension x="11" y="11"/>
				</Size>
				<Anchors>
					<Anchor point="RIGHT" relativeTo="ZPerl_AssistsCloseButton" relativePoint="LEFT">
						<Offset>
							<AbsDimension x="4" y="0"/>
						</Offset>
					</Anchor>
				</Anchors>
				<NormalTexture file="Interface\Addons\ZPerl_RaidHelper\Images\ZPerl_Pin">
					<TexCoords left="0" right="0.46875" top="0" bottom="0.453125"/>
				</NormalTexture>
				<PushedTexture file="Interface\Addons\ZPerl_RaidHelper\Images\ZPerl_Pin">
					<TexCoords left="0" right="0.46875" top="0.5" bottom="0.953125"/>
				</PushedTexture>
				<HighlightTexture file="Interface\Buttons\UI-Panel-MinimizeButton-Highlight" alphaMode="ADD">
					<TexCoords left="0" right="0.9" top="0.1" bottom="0.9"/>
				</HighlightTexture>
				<Scripts>
					<OnLoad>
						self.SetButtonTex = function()
							local tex = ZPerl_AssistPin:GetNormalTexture()
							if (ZPerlRaidHelperDB and ZPerlRaidHelperDB.AssistPinned) then
								tex:SetTexCoord(0.5, 0.96875, 0, 0.453125)
							else
								tex:SetTexCoord(0, 0.46875, 0, 0.453125)
							end

							tex = ZPerl_AssistPin:GetPushedTexture()
							if (ZPerlRaidHelperDB and ZPerlRaidHelperDB.AssistPinned) then
								if (ZPerl_Assists_Frame.corner) then
									ZPerl_Assists_Frame.corner:Hide()
								end
								tex:SetTexCoord(0.5, 0.96875, 0.5, 0.953125)
							else
								if (ZPerl_Assists_Frame.corner) then
									ZPerl_Assists_Frame.corner:Show()
								end
								tex:SetTexCoord(0, 0.46875, 0.5, 0.953125)
							end
						end
						self.tooltipText = ZPerl.L["BUTTON_HELPER_PIN"]
					</OnLoad>
					<OnClick>
						ZPerlRaidHelperDB.AssistPinned = not ZPerlRaidHelperDB.AssistPinned
						self:SetButtonTex()
					</OnClick>
				</Scripts>
			</Button>

			<ScrollFrame name="ZPerl_Target_Targetting_ScrollFrame">
				<Anchors>
					<Anchor point="TOPLEFT">
						<Offset>
							<AbsDimension x="4" y="-5"/>
						</Offset>
					</Anchor>
					<Anchor point="BOTTOMRIGHT" relativePoint="BOTTOM">
						<Offset>
							<AbsDimension x="-1" y="4"/>
						</Offset>
					</Anchor>
				</Anchors>
				<ScrollChild>
					<Frame name="ZPerl_Target_Assists_ScrollChild_Targetting" inherits="ZPerl_ListTemplate">
						<Size>
							<AbsDimension x="300" y="400"/>
						</Size>
					</Frame>
				</ScrollChild>
				<Scripts>
					<OnMouseDown>
						ZPerl.RaidHelper.AssistsMouseDown(ZPerl_Assists_Frame, button, "targetFrame")
					</OnMouseDown>
					<OnMouseUp>
						ZPerl.RaidHelper.AssistsMouseUp(ZPerl_Assists_Frame, button, "targetFrame")
					</OnMouseUp>
					<OnSizeChanged>
						ZPerl_Target_Assists_ScrollChild_Targetting:SetWidth(ZPerl_Target_Targetting_ScrollFrame:GetWidth() / ZPerl_Target_Targetting_ScrollFrame:GetEffectiveScale())
					</OnSizeChanged>
				</Scripts>
			</ScrollFrame>
			<ScrollFrame name="ZPerl_Target_Assists_ScrollFrame">
				<Anchors>
					<Anchor point="TOPLEFT" relativePoint="TOP">
						<Offset>
							<AbsDimension x="0" y="-5"/>
						</Offset>
					</Anchor>
					<Anchor point="BOTTOMRIGHT">
						<Offset>
							<AbsDimension x="-4" y="4"/>
						</Offset>
					</Anchor>
				</Anchors>
				<ScrollChild>
					<Frame name="ZPerl_Target_Assists_ScrollChild_Assists" inherits="ZPerl_ListTemplate">
						<Size>
							<AbsDimension x="300" y="400"/>
						</Size>
					</Frame>
				</ScrollChild>
				<Scripts>
					<OnSizeChanged>
						ZPerl_Target_Assists_ScrollChild_Assists:SetWidth(ZPerl_Target_Assists_ScrollFrame:GetWidth() / ZPerl_Target_Assists_ScrollFrame:GetEffectiveScale())
					</OnSizeChanged>
					<OnMouseDown>
						ZPerl.RaidHelper.AssistsMouseDown(ZPerl_Assists_Frame, button)
					</OnMouseDown>
					<OnMouseUp>
						ZPerl.RaidHelper.AssistsMouseUp(ZPerl_Assists_Frame, button)
					</OnMouseUp>
				</Scripts>
			</ScrollFrame>

			<Frame name="ZPerl_ScrollSeperator">
				<Anchors>
					<Anchor point="TOPLEFT" relativePoint="TOPRIGHT" relativeTo="ZPerl_Target_Targetting_ScrollFrame"/>
					<Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMLEFT" relativeTo="ZPerl_Target_Assists_ScrollFrame"/>
				</Anchors>
				<Layers>
					<Layer level="ARTWORK">
						<Texture file="Interface\AddOns\ZPerl_RaidHelper\Images\ZPerl_FrameBack" setAllPoints="true"/>
					</Layer>
				</Layers>
			</Frame>
		</Frames>
		<Scripts>
			<OnLoad>
				self:OnBackdropLoaded()
				ZPerl.RaidHelper.AssistsOnLoad(self)
			</OnLoad>
		</Scripts>
	</Frame>

	<Frame>
		<Scripts>
			<OnLoad>
				self:SetScript("OnUpdate", ZPerl.RaidHelper.AssistsOnUpdate)
			</OnLoad>
		</Scripts>
	</Frame>

	<!-- These two frames add to X-Perl UnitFrames. If X-Perl not loaded, then WoW will just ignore these without error -->
	<Button name="ZPerl_Player_TargettingFrame" inherits="ZPerl_BackdropTemplate" enableMouse="true" text="0" hidden="true">
		<KeyValues>
			<KeyValue key="backdropInfo" value="ZPerl_Frame_Backdrop_32_16_3333" type="global"/>
		</KeyValues>
		<Size>
			<AbsDimension x="27" y="20"/>
		</Size>
		<NormalFont style="GameFontNormalSmall"/>
		<ButtonText name="$parenttext" setAllPoints="true"/>
		<HighlightTexture file="Interface\Addons\ZPerl\Images\ZPerl_Highlight" alphaMode="ADD">
			<TexCoords left="0" right="0.25" top="0" bottom="0.5"/>
		</HighlightTexture>
		<!--<Anchors>
			<Anchor point="TOPRIGHT" relativePoint="TOPLEFT" relativeTo="ZPerl_PlayerportraitFrame">
				<Offset>
					<AbsDimension x="2" y="-19"/>
				</Offset>
			</Anchor>
		</Anchors>-->
		<Scripts>
			<OnLoad>
				self:OnBackdropLoaded()
				if ZPerl_Player then
					self:SetParent(ZPerl_Player)
					self:SetPoint("TOPRIGHT", ZPerl_PlayerportraitFrame, "TOPLEFT", 2, -19)
				end
				if (ZPerl.RegisterUnitText) then
					ZPerl.RegisterUnitText(self)
				end
			</OnLoad>
			<OnClick>
				ZPerl.RaidHelper.ToggleAssistsFrame("targetting")
				ZPerl.RaidHelper.SetFrameSides()
				ZPerl.RaidHelper.ShowAssists()
			</OnClick>
			<OnEnter>
				local title
				if (table.getn(ZPerl_Assists_Frame.targetting) > 0 and ZPerl_Assists_Frame.targetting[1][2] == "") then
					title = ZPerl.L["TOOLTIP_ENEMYONME"]
				else
					if (ZPerlRaidHelperDB.TargetCountersSelf == 0) then
						title = ZPerl.L["TOOLTIP_ALLONME"]
					else
						title = ZPerl.L["TOOLTIP_HEALERS"]
					end
				end

				local t = ZPerl.RaidHelper.MakeAssistsString(ZPerl_Assists_Frame.targetting, title)
				t = "|c00FFFFFF"..t.."\r|c009F6000"..ZPerl.L["TOOLTIP_HELP"]
				GameTooltip:SetOwner(self, "ANCHOR_BOTTOMRIGHT")
				GameTooltip:SetText(t)
				GameTooltip:Show()
			</OnEnter>
			<OnLeave>
				ZPerl.PlayerTipHide()
			</OnLeave>
		</Scripts>
	</Button>

	<Button name="ZPerl_Target_AssistFrame" inherits="ZPerl_BackdropTemplate" hidden="true">
		<KeyValues>
			<KeyValue key="backdropInfo" value="ZPerl_Frame_Backdrop_32_16_3333" type="global"/>
		</KeyValues>
		<Size>
			<AbsDimension x="27" y="20"/>
		</Size>
		<NormalFont style="GameFontNormalSmall"/>
		<ButtonText name="$parenttext" setAllPoints="true"/>
		<HighlightTexture file="Interface\Addons\ZPerl\Images\ZPerl_Highlight" alphaMode="ADD">
			<TexCoords left="0" right="0.25" top="0" bottom="0.5"/>
		</HighlightTexture>
		<Anchors>
			<Anchor point="TOPLEFT">
				<Offset>
					<AbsDimension x="-2" y="-20"/>
				</Offset>
			</Anchor>
		</Anchors>
		<Scripts>
			<OnLoad>
				self:OnBackdropLoaded()
				if (ZPerl_Target) then
					self:SetParent(ZPerl_Target)
					self:ClearAllPoints()
					self:SetPoint("TOPLEFT", ZPerl_Target.portraitFrame, "TOPRIGHT", -2, -20)
					self:Raise()
				end
				if (ZPerl.RegisterUnitText) then
					ZPerl.RegisterUnitText(self)
				end
			</OnLoad>
			<OnClick>
				ZPerl.RaidHelper.ToggleAssistsFrame("assists")
				ZPerl.RaidHelper.SetFrameSides()
				ZPerl.RaidHelper.ShowAssists()
			</OnClick>
			<OnEnter>
				local t = ZPerl.RaidHelper.MakeAssistsString(ZPerl_Assists_Frame.assists, ZPerl.L["TOOLTIP_ASSISTING"])
				t = "|c00FFFFFF"..t.."\r|c009F6000"..ZPerl.L["TOOLTIP_HELP"]
				GameTooltip:SetOwner(self, "ANCHOR_BOTTOMRIGHT")
				GameTooltip:SetText(t)
				GameTooltip:Show()
			</OnEnter>
			<OnLeave>
				ZPerl.PlayerTipHide()
			</OnLeave>
		</Scripts>
	</Button>

	<Frame name="ZPerl_AggroAnchor" frameStrata="HIGH" parent="UIParent" inherits="ZPerl_BackdropTemplate" movable="true">
		<Size>
			<AbsDimension x="32" y="32"/>
		</Size>
		<Frames>
			<Frame name="$parentArrows" inherits="ZPerl_BackdropTemplate" setAllPoints="true">
				<Layers>
					<Layer level="ARTWORK">
						<Texture name="$parenttex" file="Interface\Addons\ZPerl_RaidHelper\Images\ZPerl_MoveCursor" setAllPoints="true"/>
					</Layer>
				</Layers>
				<Scripts>
					<OnLoad>
						self:RegisterForDrag("LeftButton")
					</OnLoad>
					<OnHide>
						ZPerl_AggroAnchor:StopMovingOrSizing()
						if (ZPerl_Aggro) then
							ZPerl_Aggro:SetScript("OnUpdate", ZPerl.RaidHelper.RefreshAggro)
							ZPerl_AggroPlayer:Hide()
							ZPerl_AggroPet:Hide()
							ZPerl_Aggro:Hide()
						end
					</OnHide>
					<OnEnter>
						GameTooltip:SetOwner(self, "ANCHOR_CURSOR")
						GameTooltip:SetText(ZPerl.L["AGGRO_DRAGTIP"], 1, 1, 1)
					</OnEnter>
					<OnLeave>
						GameTooltip:Hide()
					</OnLeave>
					<OnDragStart>
						ZPerl_AggroAnchor:SetFrameStrata("DIALOG")
						GameTooltip:Hide()
						self.tex:Hide()
						ZPerl_AggroPlayer:SetVertexColor(0, 0, 1)
						ZPerl_AggroPet:SetVertexColor(0, 0, 1)
						ZPerl_AggroPlayer:SetAlpha(1)
						ZPerl_AggroPet:SetAlpha(1)
						ZPerl_AggroPlayer:Show()
						ZPerl_AggroPet:Show()
						ZPerl_Aggro:SetScript("OnUpdate", nil)
						ZPerl_Aggro:Show()
						ZPerl_AggroAnchor:StartMoving()
					</OnDragStart>
					<OnDragStop>
						ZPerl_AggroAnchor:SetFrameStrata("MEDIUM")
						self.tex:Show()
						ZPerl_Aggro:SetScript("OnUpdate", ZPerl.RaidHelper.RefreshAggro)
						ZPerl_AggroAnchor:StopMovingOrSizing()

						ZPerl_AggroPlayer:Hide()
						ZPerl_AggroPet:Hide()
						ZPerl_Aggro:Hide()

						if (ZPerl.SavePosition) then
							ZPerl.SavePosition(ZPerl_AggroAnchor)
						end
					</OnDragStop>
				</Scripts>
			</Frame>
		</Frames>
		<Scripts>
			<OnLoad>
				ZPerl.SetChildMembers(self)

				self.Enable = function(self)
					self.Arrows:Show()
					self:EnableMouse(true)
					self:SetFrameStrata("MEDIUM")
				end
				self.Disable = function(self)
					self.Arrows:Hide()
					self:EnableMouse(false)
					self:SetFrameStrata("HIGH")
				end

				self:Disable()
			</OnLoad>
		</Scripts>
	</Frame>

	<Frame name="ZPerl_Aggro" parent="ZPerl_AggroAnchor" inherits="ZPerl_BackdropTemplate" hidden="true">
		<Scripts>
			<OnLoad>
				ZPerl_AggroPlayer:SetText(ZPerl.L["AGGRO_PLAYER"])
				ZPerl_AggroPet:SetText(ZPerl.L["AGGRO_PET"])
				self:SetScript("OnUpdate", ZPerl.RaidHelper.RefreshAggro)
			</OnLoad>
			<OnHide>
				self.playerFadeStart = nil
				self.petFadeStart = nil
			</OnHide>
		</Scripts>
		<Size>
			<AbsDimension x="256" y="64"/>
		</Size>
		<Anchors>
			<Anchor point="CENTER"/>
		</Anchors>
		<Layers>
			<Layer level="OVERLAY">
				<FontString name="$parentPlayer" outline="THICK" font="GameFont_Gigantic" justifyH="CENTER" hidden="true">
					<FontHeight>
						<AbsValue val="42"/>
					</FontHeight>
				</FontString>
				<FontString name="$parentPet" outline="THICK" font="SystemFont_Huge1" justifyH="CENTER" hidden="true">
					<Anchors>
						<Anchor point="TOP" relativeTo="$parentPlayer" relativePoint="BOTTOM" />
					</Anchors>
					<FontHeight>
						<AbsValue val="16"/>
					</FontHeight>
				</FontString>
			</Layer>
		</Layers>
	</Frame>
</Ui>
